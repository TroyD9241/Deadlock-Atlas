  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:theme": "tsx scripts/check-theme.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
